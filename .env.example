# Public site URL (canonical URLs, sitemap, OG)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form (Resend). Without RESEND_API_KEY the form falls back to mailto.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Keystatic admin at /keystatic. Local dev needs none of these (edits files on disk).
# Production uses GitHub mode: commits go to this repo and trigger a Vercel redeploy.
# Create a GitHub App via /keystatic once with the first three set, then copy its values.
NEXT_PUBLIC_KEYSTATIC_GITHUB_REPO=Anuoluwa-samuel/That-Shameless-Developer
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
